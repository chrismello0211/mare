{
  "name": "mare",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Maré — PWA de hidratação (pt-BR)",
  "scripts": {
    "dev": "serve public -l 5173 --no-clipboard --no-port-switching",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rules": "node scripts/rules-test.mjs",
    "test:all": "npm test && npm run test:rules && npm run test:e2e",
    "icons": "node scripts/icons.mjs",
    "art": "node scripts/art/build.mjs",
    "deploy": "npm run icons && firebase deploy --only firestore,functions,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.48.0",
    "esbuild": "^0.21.5",
    "firebase": "10.14.1",
    "hidane": "^0.6.0",
    "serve": "^14.2.4",
    "sharp": "^0.33.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
